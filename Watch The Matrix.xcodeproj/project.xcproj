  "targets": [
    {
      "name": "Watch The Matrix",
      "id": "A59A0C4625DD6AC000B5EDAA",
      "product": "Products/Watch The Matrix.app",
      "product-type": "application.watchapp2-container",
      "dependencies": [
        "Watch The Matrix WatchKit App",
      ],
      "build-phases": [
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "39",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.pixlwave.Watch-The-Matrix",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "Watch The Matrix WatchKit App",
      "id": "A59A0C4A25DD6AC000B5EDAA",
      "product": "Products/Watch The Matrix WatchKit App.app",
      "product-type": "application",
      "build-phases": [
        "resources",
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "KeychainAccess",
          "product-name": "KeychainAccess",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Matrix",
          "product-name": "Matrix",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-html-entities",
          "product-name": "HTMLEntities",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_COMPLICATION_NAME": "Complication",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Resources/Watch The Matrix WatchKit Extension.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "39",
        "INFOPLIST_FILE": "Watch App/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.pixlwave.Watch-The-Matrix.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "4",
        "WATCHOS_DEPLOYMENT_TARGET": "10.0",
      },
    }, {
      "name": "Tests",
      "id": "A538FDFC26B479B7004F37F6",
      "product": "Products/Tests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Watch The Matrix WatchKit App",
      "dependencies": [
        "Watch The Matrix WatchKit App",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "INFOPLIST_FILE": "Tests/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.pixlwave.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "4",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Watch The Matrix WatchKit App.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Watch The Matrix WatchKit App",
        "WATCHOS_DEPLOYMENT_TARGET": "10.0",
      },
    },
  ],
